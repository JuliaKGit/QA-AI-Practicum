# =============================================================================
# Run tests — required to clone and run Playwright
# =============================================================================

# Base URL for the app under test (Playwright baseURL); BuddyTime test environment
APP_URL=https://example.test.buddytime.ca

# Email for the main test family account (auth.setup)
APP_USER_EMAIL=main-family@example.com

# Password for APP_USER_EMAIL
APP_USER_PASSWORD=your-main-password-here

# Email for a second family account (two-parent flows; tests skip if unset)
APP_ALT_USER_EMAIL=alt-family@example.com

# Password for APP_ALT_USER_EMAIL
APP_ALT_USER_PASSWORD=your-alt-password-here

# =============================================================================
# Agent / CI setup — not needed for npx playwright test alone
# =============================================================================

# Cursor API key for headless agent in .github/workflows/test-generation.yml
CURSOR_API_KEY=cur_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atlassian Cloud site URL (e.g. https://your-site.atlassian.net)
ATLASSIAN_BASE_URL=https://example.atlassian.net

# Atlassian account email used with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com

# Atlassian API token for Jira/Confluence automation
ATLASSIAN_API_TOKEN=your-atlassian-api-token-here

# Jira project key for stories and bugs
JIRA_PROJECT_KEY=AQPBT

# Confluence space key for feature documentation
CONFLUENCE_SPACE_KEY=AQPBT
